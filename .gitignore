# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE directories
.vscode/
.idea/
*.swp
*.swo

# Node / Logs (if any in future)
node_modules/
*.log

# Extension archives
*.zip

# Build output is ignored, with one deliberate exception: the userscript bundle
# is tracked because it is the artifact you install on iOS, where there is no
# way to run the build. A directory exclusion cannot be negated per-file, hence
# dist/* rather than dist/. tests/run.js fails if the tracked copy goes stale.
dist/*
!dist/socials-video-controls.user.js

