{
  "manifest_version": 3,
  "name": "Socials Video Controls",
  "version": "1.9.0",
  "description": "Frame-accurate video navigation and A-B loop practice for Instagram and Facebook, plus a full control bar on Instagram.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.facebook.com/*"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "content/core.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
